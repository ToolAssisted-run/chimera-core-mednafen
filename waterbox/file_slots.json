{
 "_comment": "This file lists the kinds of file a project of this core can hold. Chimera's New Project window is built from it. Each kind is called a slot. A slot has a title, the number of files it takes (min and max), the file extensions it accepts and the help text shown to the user. Chimera shows the form and checks the chosen files against it. A project file records its files under the slot ids used here.",
 "slots": [
  {
   "id": "disc",
   "title": "slot.disc",
   "min": 1,
   "max": 8,
   "formats": [
    "cue",
    "chd"
   ],
   "help": "slot.disc.help",
   "exposedWhen": {
    "setting": "machine",
    "in": [
     "saturn",
     "pcfx"
    ]
   }
  },
  {
   "id": "cart",
   "title": "setting.ss_cart",
   "min": 1,
   "max": 1,
   "formats": [
    "vb",
    "vboy",
    "lnx"
   ],
   "help": "slot.cart.help",
   "exposedWhen": {
    "setting": "machine",
    "in": [
     "virtualboy",
     "lynx"
    ]
   }
  },
  {
   "id": "romset",
   "title": "slot.romset",
   "min": 1,
   "max": 1,
   "formats": [
    "zip"
   ],
   "help": "slot.romset.help",
   "exposedWhen": {
    "setting": "machine",
    "is": "stv"
   }
  },
  {
   "id": "savedata",
   "title": "slot.savedata",
   "min": 0,
   "max": 2,
   "formats": [
    "bkr",
    "bcr",
    "sav",
    "fxb",
    "seep"
   ],
   "help": "slot.savedata.help",
   "exposedWhen": {
    "setting": "machine",
    "in": [
     "saturn",
     "pcfx",
     "virtualboy",
     "stv"
    ]
   },
   "namePattern": "\\.(bkr|bcr|sav|fxb|seep)$",
   "nameHelp": "slot.savedata.name_help"
  }
 ]
}
