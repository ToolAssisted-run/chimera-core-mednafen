 ],
 "_firmware_note": "The firmware that does not depend on the game. Which BIOS a Saturn starts with depends on the disc's region, so the core says it for each game (gameFirmware): saturn_jp.bin or saturn_na_eu.bin, and the ROM cartridge of the two games sold with one. An ST-V's BIOS is taken out of MAME's set of them, stvbios.zip.",
 "firmware": [
  {
   "id": "pcfx.rom",
   "display": "PC-FX BIOS",
   "description": "The PC-FX's BIOS (1 MB). The console starts from it. It is usually named pcfx.rom; versions 1.00 and 1.01 both work. It is NEC's and you have to supply it.",
   "size": 1048576,
   "name": "pcfx.rom",
   "requiredWhen": {
    "setting": "machine",
    "in": [
     "pcfx"
    ]
   }
  },
  {
   "id": "lynxboot.img",
   "display": "Lynx boot ROM",
   "description": "The Lynx's boot ROM (512 bytes). The console starts from it and it checks the cartridge. It is Atari's and you have to supply it.",
   "size": 512,
   "sha1": "E4ED47FAE31693E016B081C6BDA48DA5B70D7CCB",
   "name": "lynxboot.img",
   "requiredWhen": {
    "setting": "machine",
    "in": [
     "lynx"
    ]
   }
  },
  {
   "id": "stvbios.zip",
   "display": "ST-V BIOS set",
   "description": "The BIOS of the ST-V board, as the set of them MAME uses: stvbios.zip, a zip of the BIOS of every region (512 KB each). The core takes out the one for the game's region, by its contents and not by its name, so a set from any version of MAME works. It is Sega's and you have to supply it.",
   "name": "stvbios.zip",
   "requiredWhen": {
    "setting": "machine",
    "in": [
     "stv"
    ]
   }
  },
  {
   "id": "satar4mp.bin",
   "display": "Action Replay 4M Plus ROM",
   "description": "The ROM of the Action Replay 4M Plus cartridge. It is needed when the Cartridge setting is 'ar4mp'. You have to supply it.",
   "name": "satar4mp.bin",
   "requiredWhen": {
    "all": [
     {
      "setting": "machine",
      "in": [
       "saturn"
      ]
     },
     {
      "setting": "ss.cart",
      "is": "ar4mp"
     }
    ]
   }
  }
 ]
}
