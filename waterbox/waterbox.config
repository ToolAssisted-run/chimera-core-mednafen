{
 "coreName": "Mednafen",
 "author": "The Mednafen Team; chimera port by Sergio Martin",
 "url": "https://github.com/ToolAssisted-run/chimera-core-mednafen",
 "romFile": "disc",
 "deterministic": true,
 "suggestSettings": true,
 "gameFirmware": true,
 "memoryLayoutMiB": [
  512,
  8,
  16,
  64,
  512
 ],
 "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. This is room, not use: memory is taken as a machine touches it. A Saturn's savestate is about 7 MB.",
 "video": {
  "_comment": "The BUFFER CAPACITY. Each system has its own picture size and the Saturn changes its own with the game's video mode, so the live size comes from GetVideoWidth/Height every frame.",
  "width": 2048,
  "height": 1024,
  "virtualWidth": 320,
  "virtualHeight": 240,
  "vsyncNumerator": 60000,
  "vsyncDenominator": 1000,
  "_vsync_note": "Each system has its own refresh rate, and a PAL Saturn another; GetVsyncNumerator reports the running machine's, in thousandths of a hertz.",
  "getBgra": "GetVideoBgra"
 },
 "audio": {
  "_comment": "Mednafen's mix of the machine's sound at 44.1 kHz stereo. That is the rate of the Saturn's sound chip and of a CD's audio, so neither is converted; the other three systems' sound is made at whatever rate is asked for.",
  "rate": 44100,
  "samplesPerFrame": 4096,
  "channels": 2,
  "get": "GetAudio"
 },
 "lag": {
  "inputWasRead": "InputWasRead"
 },
 "systemNames": {
  "SAT": "Sega Saturn",
  "VB": "Virtual Boy",
  "PCFX": "PC-FX",
  "LYNX": "Atari Lynx",
  "STV": "Sega ST-V"
 },
 "settings": [
  {
   "name": "machine",
   "display": "Machine",
   "description": "Which console this project is for. Everything else depends on it, so changing it restarts the core.",
   "type": "enum",
   "options": [
    "saturn",
    "virtualboy",
    "pcfx",
    "lynx",
    "stv"
   ],
   "default": "saturn"
  },
  {
   "name": "ss.input.port1",
   "display": "Port 1",
   "description": "What is plugged into port 1. Ports 1 and 2 are the console's own when no multitap is plugged in. With a multitap in the first socket, ports 1 to 6 are on it and the next port is the second socket. 'none' leaves the port empty. It is part of the machine, so a movie needs the same value.",
   "type": "enum",
   "options": [
    "none",
    "gamepad",
    "3dpad",
    "mouse",
    "wheel",
    "mission",
    "dmission",
    "gun",
    "keyboard",
    "jpkeyboard"
   ],
   "default": "gamepad",
   "when": [
    "saturn"
   ]
  },
  {
   "name": "ss.input.port2",
   "display": "Port 2",
   "description": "What is plugged into port 2. Ports 1 and 2 are the console's own when no multitap is plugged in. With a multitap in the first socket, ports 1 to 6 are on it and the next port is the second socket. 'none' leaves the port empty. It is part of the machine, so a movie needs the same value.",
