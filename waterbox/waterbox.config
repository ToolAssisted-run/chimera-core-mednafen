  {
   "name": "pcfx.cpu_emulation",
   "display": "Processor Emulation",
   "description": "How closely the processor's timing is followed. 'accurate' counts every step, 'fast' does not, and 'auto' uses 'accurate' for the games known to need it. It is part of the machine, so a movie needs the same value.",
   "type": "enum",
   "options": [
    "fast",
    "accurate",
    "auto"
   ],
   "default": "auto",
   "when": [
    "pcfx"
   ]
  },
  {
   "name": "pcfx.cdspeed",
   "display": "Disc Drive Speed",
   "description": "How many times faster than the real drive the disc is read. 2 is the console's own speed. It is part of the machine, so a movie needs the same value.",
   "type": "int",
   "min": 2,
   "max": 10,
   "default": 2,
   "when": [
    "pcfx"
   ]
  },
  {
   "name": "pcfx.adpcm.emulate_buggy_codec",
   "display": "Sound Of The Faulty Encoder",
   "description": "Plays compressed sound the way the faulty tool some games were made with expected it. Mednafen says it is not accurate, only better for those games. It changes the sound, so a movie's recording needs the same value.",
   "type": "bool",
   "default": false,
   "when": [
    "pcfx"
   ]
  },
  {
   "name": "pcfx.adpcm.suppress_channel_reset_clicks",
   "display": "Hide Sound Clicks",
   "description": "Removes the clicks heard when a game resets a sound channel. It changes the sound, so a movie's recording needs the same value.",
   "type": "bool",
   "default": true,
   "when": [
    "pcfx"
   ]
  },
  {
   "name": "pcfx.nospritelimit",
   "display": "No Sprite Limit",
   "description": "Draws more than the console's 16 sprites on a line. It removes flicker and can show things a game meant to hide. It changes the picture only.",
   "type": "bool",
   "default": false,
   "when": [
    "pcfx"
   ]
  },
  {
   "name": "pcfx.high_dotclock_width",
   "display": "Width Of The Wide Mode",
   "description": "How many pixels wide the picture is handed out in the console's highest horizontal resolution: 341 is the real number of pixels, 256 loses detail, 1024 keeps every mode the same width. It changes the picture only.",
   "type": "enum",
   "options": [
    "256",
    "341",
    "1024"
   ],
   "default": "1024",
   "when": [
    "pcfx"
   ]
  },
  {
   "name": "pcfx.rainbow.chromaip",
   "display": "Smooth Video Colours",
   "description": "Smooths the colour of the console's video playback between pixels. It changes the picture only.",
   "type": "bool",
   "default": false,
   "when": [
    "pcfx"
   ]
  },
  {
   "name": "pcfx.slstart",
   "display": "First Line",
   "description": "The first line of the picture that is shown. It changes the picture only.",
   "type": "int",
   "min": 0,
   "max": 239,
   "default": 4,
   "when": [
    "pcfx"
   ]
  },
  {
   "name": "pcfx.slend",
   "display": "Last Line",
   "description": "The last line of the picture that is shown. It changes the picture only.",
   "type": "int",
   "min": 0,
   "max": 239,
   "default": 235,
   "when": [
    "pcfx"
   ]
  },
  {
   "name": "lynx.rotateinput",
   "display": "Turn The Pad With The Screen",
   "description": "Some games are played with the console held upright. This turns the direction pad with the picture, so Up is still up. It is part of the machine, so a movie needs the same value.",
   "type": "bool",
   "default": true,
   "when": [
    "lynx"
   ]
  },
  {
   "name": "lynx.lowpass",
   "display": "Soften The Sound",
   "description": "Passes the sound through a filter like the console's small speaker. It changes the sound, so a movie's recording needs the same value.",
   "type": "bool",
   "default": true,
   "when": [
    "lynx"
   ]
  },
  {
   "name": "stv.region",
   "display": "Region",
   "description": "The region of the board, which decides the BIOS it starts from and, in many games, the language. 'game' is the region Mednafen's list gives the game. 'jp' is Japan, 'na' North America and 'eu' Europe; not every game runs in every region. It is part of the machine, so a movie needs the same value.",
   "type": "enum",
   "options": [
    "game",
    "jp",
    "na",
    "eu"
   ],
   "default": "game",
   "when": [
    "stv"
   ]
  },
  {
   "name": "initialTime",
   "display": "Starting Clock",
   "description": "What the machine's clock shows when it is switched on, in seconds since 1970 (Unix time). The Saturn's clock and the ST-V's are set from it. This is a setting, and not your computer's clock, so that a movie plays back the same on any day.",
   "type": "int",
   "min": 0,
   "max": 2147483647,
   "default": 946684800,
   "when": [
    "saturn",
    "stv"
   ]
  }
 ],
 "_discs_note": "A machine that takes discs has three controls of the drive. Previous Disc and Next Disc move a selector over the project's discs and touch nothing. Disc Swap is the lid: up for as long as it is held, and closing on the selected disc, or on the next one when the selector was not moved.",
 "_machines_note": "ONE core.wbx, four systems and five machines: the ST-V arcade board is the Saturn's hardware and Mednafen runs it as the same system. What they share is above; what makes them different machines is below, and the 'machine' setting picks one. A machine's controls are every input of every device its ports take, by Mednafen's own tables: the ones of what is plugged in are shown and the rest leave the input roll.",
 "machineSetting": "machine",
 "machines": [
  {
