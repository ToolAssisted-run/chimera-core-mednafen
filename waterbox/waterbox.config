   ]
  },
  {
   "name": "ss.region_autodetect",
   "display": "Region From The Game",
   "description": "Takes the console's region from the game's disc. Turn it off to use the region set below, for a disc that names several regions or the wrong one. It is part of the machine, so a movie needs the same value.",
   "type": "bool",
   "default": true,
   "when": [
    "saturn"
   ]
  },
  {
   "name": "ss.region_default",
   "display": "Region",
   "description": "The console's region when it is not taken from the game: jp is Japan, na North America, eu Europe, kr Korea, tw Taiwan, as Asia, br Brazil, la Latin America. Japan and Taiwan use the Japanese BIOS file and the others the North American and European one. It is part of the machine, so a movie needs the same value.",
   "type": "enum",
   "options": [
    "jp",
    "na",
    "eu",
    "kr",
    "tw",
    "as",
    "br",
    "la"
   ],
   "default": "jp",
   "when": [
    "saturn"
   ]
  },
  {
   "name": "ss.cart",
   "display": "Cartridge",
   "description": "What is in the cartridge slot. 'auto' picks what the game is known to need and the backup memory cartridge otherwise. 'backup' is a memory cartridge for saves, 'extram1' and 'extram4' are the 1 MB and 4 MB RAM cartridges some games require, 'cs1ram16' is a 16 MB RAM cartridge for homebrew, and 'ar4mp' is the Action Replay 4M Plus, which needs its own ROM file. It is part of the machine, so a movie needs the same value.",
   "type": "enum",
   "options": [
    "auto",
    "none",
    "backup",
    "extram1",
    "extram4",
    "cs1ram16",
    "ar4mp"
   ],
   "default": "auto",
   "when": [
    "saturn"
   ]
  },
  {
   "name": "ss.cart.auto_default",
   "display": "Cartridge When The Game Needs None",
   "description": "The cartridge that 'auto' plugs in for a game that is not known to need one. It is part of the machine, so a movie needs the same value.",
   "type": "enum",
   "options": [
    "none",
    "backup",
    "extram1",
    "extram4",
    "cs1ram16",
    "ar4mp"
   ],
   "default": "backup",
   "when": [
    "saturn"
   ]
  },
  {
   "name": "ss.input.sport1.multitap",
   "display": "Multitap In Socket 1",
   "description": "Plugs a six-player multitap into the console's first controller socket. It is part of the machine, so a movie needs the same value.",
   "type": "bool",
   "default": false,
   "when": [
    "saturn"
   ]
  },
  {
   "name": "ss.input.sport2.multitap",
   "display": "Multitap In Socket 2",
   "description": "Plugs a six-player multitap into the console's second controller socket. It is part of the machine, so a movie needs the same value.",
   "type": "bool",
   "default": false,
   "when": [
    "saturn"
   ]
  },
  {
   "name": "ss.smpc.autortc",
   "display": "Set The Clock At Start",
   "description": "Sets the console's clock and language when the machine starts, so the BIOS does not stop to ask for them. The time is the Starting Clock setting. It is part of the machine, so a movie needs the same value.",
   "type": "bool",
   "default": true,
   "when": [
    "saturn"
   ]
  },
  {
   "name": "ss.smpc.autortc.lang",
   "display": "BIOS Language",
   "description": "The language the console is set to when the clock is set at start. Games read it to choose their own language. It is part of the machine, so a movie needs the same value.",
   "type": "enum",
   "options": [
    "english",
    "german",
    "french",
    "spanish",
    "italian",
    "japanese"
   ],
   "default": "english",
   "when": [
    "saturn"
   ]
  },
  {
   "name": "ss.h_overscan",
   "display": "Show The Side Borders",
   "description": "Shows the strips at the left and right edges of the picture that a television hid. It changes the picture only.",
   "type": "bool",
   "default": true,
   "when": [
    "saturn",
    "stv"
   ]
  },
  {
   "name": "ss.h_blend",
   "display": "Blend Neighbouring Pixels",
   "description": "Blurs each line a little from left to right, as a television did. Some games rely on it to mix colours. It changes the picture only.",
   "type": "bool",
   "default": false,
   "when": [
    "saturn",
    "stv"
   ]
  },
  {
   "name": "ss.correct_aspect",
   "display": "Television Shape",
   "description": "Shows the picture in the shape it had on a television. Turn it off to show the pixels as squares. It changes the picture only.",
   "type": "bool",
   "default": true,
   "when": [
    "saturn",
    "stv"
   ]
  },
  {
   "name": "ss.slstart",
   "display": "First Line (NTSC)",
   "description": "The first line of the picture that is shown on an NTSC console. It changes the picture only.",
   "type": "int",
   "min": 0,
   "max": 239,
   "default": 0,
   "when": [
    "saturn",
    "stv"
   ]
  },
  {
   "name": "ss.slend",
   "display": "Last Line (NTSC)",
   "description": "The last line of the picture that is shown on an NTSC console. It changes the picture only.",
   "type": "int",
   "min": 0,
   "max": 239,
   "default": 239,
   "when": [
    "saturn",
    "stv"
   ]
  },
  {
   "name": "ss.slstartp",
   "display": "First Line (PAL)",
   "description": "The first line of the picture that is shown on a PAL console. It changes the picture only.",
   "type": "int",
   "min": -16,
   "max": 271,
   "default": 0,
   "when": [
    "saturn"
   ]
  },
  {
   "name": "ss.slendp",
   "display": "Last Line (PAL)",
   "description": "The last line of the picture that is shown on a PAL console. It changes the picture only.",
   "type": "int",
   "min": -16,
   "max": 271,
   "default": 255,
   "when": [
    "saturn"
   ]
  },
  {
   "name": "vb.cpu_emulation",
   "display": "Processor Emulation",
   "description": "How closely the processor's timing is followed. 'accurate' counts every step and a few games need it. 'fast' is Mednafen's default. It is part of the machine, so a movie needs the same value.",
   "type": "enum",
   "options": [
    "fast",
    "accurate"
   ],
   "default": "fast",
   "when": [
    "virtualboy"
   ]
  },
  {
   "name": "vb.input.instant_read_hack",
   "display": "Read The Pad At Once",
   "description": "Gives the game the pad's buttons at the moment it asks for them and not after the console's real delay of a frame. It is Mednafen's default. It is part of the machine, so a movie needs the same value.",
   "type": "bool",
   "default": true,
   "when": [
    "virtualboy"
   ]
  },
  {
   "name": "vb.instant_display_hack",
   "display": "Show The Frame At Once",
   "description": "Shows a frame as soon as it is drawn and not when the console's displays would light it. It changes which frame a picture belongs to, so a movie needs the same value.",
   "type": "bool",
   "default": false,
   "when": [
    "virtualboy"
   ]
  },
  {
   "name": "vb.3dmode",
   "display": "How The Two Eyes Are Shown",
   "description": "The console shows a picture to each eye. 'anaglyph' puts both on one picture in two colours for coloured glasses, 'sidebyside' puts them next to each other, 'cscope' is the layout of a CyberScope viewer, 'vli' and 'hli' weave them line by line, and 'left' and 'right' show one eye only. It changes the picture only.",
   "type": "enum",
   "options": [
    "anaglyph",
    "cscope",
    "sidebyside",
    "vli",
    "hli",
    "left",
    "right"
   ],
   "default": "anaglyph",
   "when": [
    "virtualboy"
   ]
  },
  {
   "name": "vb.anaglyph.preset",
   "display": "Glasses Colours",
   "description": "The two colours of the 'anaglyph' picture, named after the glasses they suit. It changes the picture only.",
   "type": "enum",
   "options": [
    "red_blue",
    "red_cyan",
    "red_electriccyan",
    "red_green",
    "green_magenta",
    "yellow_blue"
   ],
   "default": "red_blue",
   "when": [
    "virtualboy"
   ]
  },
  {
   "name": "vb.3dreverse",
   "display": "Swap The Eyes",
   "description": "Gives the left eye's picture to the right eye and the right eye's to the left. It changes the picture only.",
   "type": "bool",
   "default": false,
   "when": [
    "virtualboy"
   ]
  },
  {
   "name": "vb.disable_parallax",
   "display": "Flat Picture",
   "description": "Draws both eyes' pictures the same, with no depth. It changes the picture only.",
   "type": "bool",
   "default": false,
   "when": [
    "virtualboy"
   ]
  },
  {
   "name": "vb.sidebyside.separation",
   "display": "Gap Between The Eyes",
   "description": "The number of empty pixels between the two pictures of the 'sidebyside' layout. It changes the picture only.",
   "type": "int",
   "min": 0,
   "max": 1024,
   "default": 0,
   "when": [
    "virtualboy"
   ]
  },
  {
   "name": "pcfx.input.port1",
   "display": "Port 1",
   "description": "What is plugged into port 1. Ports 1 and 2 are the console's own. Ports 3, 4 and 5 are the extra ones of a multitap in the first socket, and ports 6, 7 and 8 those of one in the second. 'none' leaves the port empty. It is part of the machine, so a movie needs the same value.",
   "type": "enum",
   "options": [
    "none",
    "gamepad",
    "mouse"
   ],
   "default": "gamepad",
   "when": [
    "pcfx"
   ]
  },
