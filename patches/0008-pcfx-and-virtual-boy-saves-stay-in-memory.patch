+ // Chimera writes it to a file when the user exports it.
+ return;
+#endif
  if(!BRAMDisabled)
  {
   FileStream fp(MDFN_MakeFName(MDFNMKF_SAV, 0, "sav"), FileStream::MODE_WRITE_INPLACE);
@@ -992,6 +1006,11 @@
 
