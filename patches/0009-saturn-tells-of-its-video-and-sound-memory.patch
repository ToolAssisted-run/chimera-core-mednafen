+#if defined(CHIMERA_CORE)
+// chimera: the colour memory a byte at a time, as the processor finds it.
+// Where a colour is kept depends on the colour mode, and the part that draws
+// has a copy of its own, so a byte is read and written the way a game's is.
+static uint8 ChimeraPeekCRAM(uint32 offset)
+{
+ uint16 DB;
+
+ RW<uint16, false>(0x100000 + (offset & 0xFFE), &DB);
+
+ return DB >> ((~offset & 1) << 3);
+}
+
+static void ChimeraPokeCRAM(uint32 offset, uint8 value)
+{
+ const unsigned shift = (~offset & 1) << 3;
+ uint16 DB;
+
+ RW<uint16, false>(0x100000 + (offset & 0xFFE), &DB);
+ DB = (DB & ~(0xFF << shift)) | (value << shift);
+ Write16_DB(0x100000 + (offset & 0xFFE), DB);
+}
+#endif
