 // the extension Mednafen saves it with ("bkr"). "words" as above; a file of
 // such a memory holds the words high byte first.
 void MDFN_ChimeraSaveMemory(const char* ext, void* memory, uint64 bytes, bool words);
+// A firmware file that is not a file of its own: the frontend fills "dest"
+// with the "bytes" bytes of the ROM that the setting "setting" names (an ST-V's
+// BIOS is one of several in a set of them), and returns false when it leaves
+// the file to be read as Mednafen always did.
+bool MDFN_ChimeraFirmware(const char* setting, uint8* dest, uint32 bytes);
 #endif
 
